# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=Education Management System
CLIENT_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/edu_system

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=edu-system
JWT_AUDIENCE=edu-system-clients

# ─── Password Reset ──────────────────────────────────────────────────────────
RESET_TOKEN_EXPIRES_IN_MINUTES=30

# ─── Activation Codes ────────────────────────────────────────────────────────
ACTIVATION_CODE_EXPIRES_IN_DAYS=14
ACTIVATION_CODE_LENGTH=10

# ─── Business Rules ──────────────────────────────────────────────────────────
ATTENDANCE_WARNING_THRESHOLD=50

# ─── File Storage: "cloudinary" | "local" ────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=100
LOCAL_UPLOAD_DIR=uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=edu-system

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ─── CORS (comma separated, "*" allows all) ──────────────────────────────────
CORS_ORIGINS=*

# ─── Logging: error | warn | info | http | debug ──────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Mail (optional; leave SMTP_HOST empty to log emails instead) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Education System <no-reply@edu-system.local>"

# ─── Bootstrap Instructor (used by `npm run seed`) ───────────────────────────
SEED_INSTRUCTOR_NAME=Head Instructor
SEED_INSTRUCTOR_EMAIL=instructor@edu-system.local
SEED_INSTRUCTOR_PASSWORD=Instructor@123
SEED_INSTRUCTOR_PHONE=+201000000000
