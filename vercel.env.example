# Copy these into Vercel → Project Settings → Environment Variables
# Apply to Production (and Preview if needed).

NODE_ENV=production
API_PREFIX=/api/v1
APP_NAME=Education Management System
CLIENT_URL=https://your-frontend.vercel.app

# MongoDB Atlas (allow 0.0.0.0/0 in Atlas Network Access for Vercel)
MONGODB_URI=mongodb://<username>:<password>@<cluster-hosts>/edu_system?ssl=true&replicaSet=<replica-set>&authSource=admin&appName=Cluster0

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=edu-system
JWT_AUDIENCE=edu-system-clients

RESET_TOKEN_EXPIRES_IN_MINUTES=30
ACTIVATION_CODE_EXPIRES_IN_DAYS=14
ACTIVATION_CODE_LENGTH=10
ATTENDANCE_WARNING_THRESHOLD=50

# Use Cloudinary on Vercel — local disk uploads do not persist across requests
STORAGE_DRIVER=cloudinary
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_IMAGE_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=edu-system

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
CORS_ORIGINS=*
LOG_LEVEL=info
